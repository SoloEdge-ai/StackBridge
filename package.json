{
  "name": "stackbridge",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first AI terminal workbench across Windows, SSH Linux, and Docker",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "desktop:portable": "pnpm build && pnpm --filter @stackbridge/desktop package:portable",
    "dev": "pnpm --parallel --filter @stackbridge/core --filter @stackbridge/web dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ]
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
